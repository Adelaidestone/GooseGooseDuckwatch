[Unit]
Description=GooseGooseDuck Records FastAPI
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/GooseGooseDuck
EnvironmentFile=/etc/ggd.env
ExecStart=/opt/ggd-venv/bin/python -m uvicorn web.app:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
